{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AuthorResponse": {
      "additionalProperties": false,
      "properties": {
        "author_name": {
          "title": "Author Name",
          "type": "string"
        },
        "correction_refs": {
          "items": {
            "type": "string"
          },
          "title": "Correction Refs",
          "type": "array"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "reproduction_confirmed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reproduction Confirmed"
        },
        "response": {
          "title": "Response",
          "type": "string"
        }
      },
      "required": [
        "author_name",
        "received_at",
        "response"
      ],
      "title": "AuthorResponse",
      "type": "object"
    },
    "ClaimSpec": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "decision_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Policy"
        },
        "optional_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Optional Dimensions",
          "type": "array"
        },
        "required_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Required Dimensions",
          "type": "array"
        },
        "scope": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Scope",
          "type": "object"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "use_case": {
          "title": "Use Case",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "version",
        "statement",
        "use_case"
      ],
      "title": "ClaimSpec",
      "type": "object"
    },
    "DatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "default": "",
